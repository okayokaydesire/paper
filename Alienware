local function GetClosestPlayer()
	local closestPlayer, shortestDistance = nil, math.huge
	local localChar = LocalPlayer.Character
	local localHRP = localChar and localChar:FindFirstChild("HumanoidRootPart")
	if not localHRP then return nil end

	local localHasGun = false
	if localChar and localChar:FindFirstChild("Gun") then localHasGun = true end
	if LocalPlayer:FindFirstChild("Backpack") and LocalPlayer.Backpack:FindFirstChild("Gun") then localHasGun = true end

	if AimAssistOnlyWithGun and not localHasGun then return nil end

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			local hrp = player.Character:FindFirstChild("HumanoidRootPart")
			local hum = player.Character:FindFirstChildOfClass("Humanoid")
			if hrp and hum and hum.Health > 0 then
				local role = GetPlayerRole(player)
				if AimAssistOnlyWithGun then
					if role ~= "Murderer" then continue end
				else
					if AimAssistRoleFilter == "Murd/Sheriff" and role == "Innocent" then continue
					elseif AimAssistRoleFilter == "Murderer" and role ~= "Murderer" then continue
					elseif AimAssistRoleFilter == "Sheriff" and role ~= "Sheriff" then continue end
				end
				local distance = (hrp.Position - localHRP.Position).Magnitude
				if distance < shortestDistance then
					shortestDistance, closestPlayer = distance, player
				end
			end
		end
	end
	return closestPlayer
end

TrackConn(RunService.RenderStepped:Connect(function()
	if not AimAssistEnabled or not Active then return end
	local targetPlayer = GetClosestPlayer()
	if targetPlayer and targetPlayer.Character then
		local partName = AimAssistTarget == "Torso" and "HumanoidRootPart" or "Head"
		local targetPart = targetPlayer.Character:FindFirstChild(partName)
		if targetPart then
			local targetPos = targetPart.Position
			if AimAssistPredictionEnabled then
				local distance = (targetPos - Camera.CFrame.Position).Magnitude
				targetPos = targetPos + (targetPart.AssemblyLinearVelocity * (distance / AimAssistPrediction))
			end
			Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPos)
		end
	end
end))

TrackConn(RunService.Heartbeat:Connect(function()
	if not AutoShootEnabled or not Active then return end
	local char = LocalPlayer.Character
	if not char then return end

	local hum = char:FindFirstChildOfClass("Humanoid")
	local gun = char:FindFirstChild("Gun") or (LocalPlayer:FindFirstChild("Backpack") and LocalPlayer.Backpack:FindFirstChild("Gun"))
	if not gun or not hum then return end

	local murdPlayer, murdChar = GetMurdererV1()
	if murdChar and murdChar:FindFirstChild("HumanoidRootPart") then
		local head = char:FindFirstChild("Head")
		local targetPart = murdChar:FindFirstChild("HumanoidRootPart")
		if head and targetPart then
			local params = RaycastParams.new()
			params.FilterDescendantsInstances = {char}
			params.FilterType = Enum.RaycastFilterType.Exclude

			local distance = (targetPart.Position - head.Position).Magnitude
			local predictedPos = targetPart.Position + (targetPart.AssemblyLinearVelocity * (distance / 150))
			local result = workspace:Raycast(head.Position, (predictedPos - head.Position).Unit * 100, params)

			if result and result.Instance:IsDescendantOf(murdChar) then
				if gun.Parent == LocalPlayer.Backpack then
					hum:EquipTool(gun)
					task.wait(0.05)
				end
				Camera.CFrame = CFrame.new(Camera.CFrame.Position, predictedPos)
				gun:Activate()
			end
		end
	end
end))


