	local h = Instance.new("Highlight")
	h.Name                    = "ChamsESP"
	h.FillTransparency    = EspFillTransparency / 100
	h.OutlineTransparency = 0.25
	h.FillColor           = color
	h.OutlineColor        = color
	h.Parent              = char
