	if hrp then hrp.LocalTransparencyModifier = 1 end
	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") and part ~= hrp and part.Transparency >= 1 then
			part.Transparency = 0.99
		end
	end
	local existing = char:FindFirstChild("ChamsESP")
	if existing then
		existing.FillColor        = color
		existing.OutlineColor     = color
		existing.FillTransparency = EspFillTransparency / 100
		return
