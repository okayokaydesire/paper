local minimized = false
local slideTweenActive = false

-- Original and Minimized sizes
local normalMainSize = UDim2.new(0, 515, 0, 340)
local minimizedMainSize = UDim2.new(0, 200, 0, 36) -- Compact pill size for the topbar

local function SetMinimized(state)
	if slideTweenActive then return end
	slideTweenActive = true
	minimized = state

	minimizeBtn.Text = minimized and "+" or "-"

	if minimized then
		-- Hide the content immediately so it doesn't render during the transition
		contentRoot.Visible = false

		-- STEP 1: First, shrink the window height down to just the top bar (36px)
		local closeTween = TweenService:Create(main, TweenInfo.new(0.2, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), { 
			Size = UDim2.new(0, 515, 0, 36) 
		})

		closeTween:Play()
		closeTween.Completed:Wait()

		-- STEP 2: Then, shrink the width down into a compact mini-bar and adjust button position
		local shrinkTween = TweenService:Create(main, TweenInfo.new(0.2, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), { 
			Size = minimizedMainSize 
		})

		local btnTween = TweenService:Create(minimizeBtn, TweenInfo.new(0.2, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), { 
			Position = UDim2.new(1, -35, 0.5, -11) 
		})

		shrinkTween:Play()
		btnTween:Play()
		shrinkTween.Completed:Wait()

		slideTweenActive = false
	else
		-- STEP 1: Expand the width back out to full size while content is still invisible
		local expandWidthTween = TweenService:Create(main, TweenInfo.new(0.2, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), { 
			Size = UDim2.new(0, 515, 0, 36) 
		})

		local btnTween = TweenService:Create(minimizeBtn, TweenInfo.new(0.2, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), { 
			Position = UDim2.new(1, -40, 0.5, -10) 
		})

		expandWidthTween:Play()
		btnTween:Play()
		expandWidthTween.Completed:Wait()

		-- STEP 2: Expand the height back to the full UI size
		local expandHeightTween = TweenService:Create(main, TweenInfo.new(0.2, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), { 
			Size = normalMainSize 
		})

		expandHeightTween:Play()
		expandHeightTween.Completed:Wait()

		-- Make content visible again only *after* all animations are fully complete
		contentRoot.Visible = true
		slideTweenActive = false
	end
end

