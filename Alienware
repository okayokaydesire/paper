local function GetRoleColor(char)
	local player = Players:GetPlayerFromCharacter(char)
	if not player then return Color3.fromHSV(InnocentHue / 360, 1, 1) end

	local role = GetPlayerRole(player)
	if RoleESPEnabled then
		if role == "Murderer" then return Color3.fromHSV(MurdererHue / 360, 1, 1) end
		if role == "Sheriff" or role == "Hero" then return Color3.fromHSV(SheriffHue / 360, 1, 1) end
	end

	-- LOBBY PROXIMITY CHECK (Grey in lobby, Green/Innocent outside)
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if hrp then
		local lobby = workspace:FindFirstChild("RegularLobby") or workspace:FindFirstChild("Lobby")
		if lobby then
			local distToLobby = (hrp.Position - lobby:GetPivot().Position).Magnitude
			if distToLobby <= 120 then
				return Color3.fromRGB(150, 150, 150)
			end
		end
	end

	return Color3.fromHSV(InnocentHue / 360, 1, 1)
end

