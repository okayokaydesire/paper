-- ==============================================================================
-- BAG FULL RESET LISTENER
-- ==============================================================================
task.spawn(function()
	local Players = game:GetService("Players")
	local LocalPlayer = Players.LocalPlayer
	local ReplicatedStorage = game:GetService("ReplicatedStorage")

	local coinRemote = ReplicatedStorage:WaitForChild("Remotes", 10):WaitForChild("Gameplay", 10):WaitForChild("CoinCollected", 10)

	if coinRemote then
		coinRemote.OnClientEvent:Connect(function(bagName, currentCoins, maxCoins)
			local current = tonumber(currentCoins)
			local max = tonumber(maxCoins)

			-- Fetch character fresh
			local char = LocalPlayer.Character
			local hum = char and char:FindFirstChild("Humanoid")

			-- Reset logic check
			if CoinFarmEnabled and hum and hum.Health > 0 and current and max and (max <= current) then
				hum.Health = 0 -- Triggers Reset
			end
		end)
	end
end)
-- ==============================================================================
-- 2. MAIN AUTOFARM LOOP WITH MURDERER TRACKING & UNDERGROUND EVASION
-- ==============================================================================
task.spawn(function()
	local trackedMurdererChar = nil

	while task.wait(0.5) do
		if not Active then break end
		if not CoinFarmEnabled then continue end 

		local success, err = pcall(function()
			-- SETUP & REFRESH
			local map = getMap()
			if not map then return end 

			local coinContainer = map:FindFirstChild("CoinContainer")
			if not coinContainer then return end 

			-- Fetch character, HRP, and Humanoid, and verify you are alive
			local char = LocalPlayer.Character
			if not char or not char:IsDescendantOf(workspace) then return end
			local hrp = char:FindFirstChild("HumanoidRootPart")
			local hum = char:FindFirstChild("Humanoid")
			if not hrp or not hum or hum.Health <= 0 then return end

			-- LOBBY PROXIMITY CHECK
			local lobby = workspace:FindFirstChild("RegularLobby") or workspace:FindFirstChild("Lobby")
			if lobby then
				local distToLobby = (hrp.Position - lobby:GetPivot().Position).Magnitude
				if distToLobby <= lobbyRadius then 
					return 
				end
			end

			-- ==============================================================================
			-- MURDERER DETECTION & RESET TRACKING
			-- ==============================================================================
			local Players = game:GetService("Players")
			local LocalPlayer = Players.LocalPlayer

			local murderer, murdererChar = GetMurdererV1()
			local murdererHum = murdererChar and murdererChar:FindFirstChild("Humanoid")
			local murdererHRP = murdererChar and murdererChar:FindFirstChild("HumanoidRootPart")

			local isPlayerMurderer = (murdererChar == LocalPlayer.Character) or (murderer == LocalPlayer)

			-- Only run danger tracking if we are NOT the murderer
			if not isPlayerMurderer then
				if murdererChar and murdererHum and murdererHum.Health > 0 then
					if trackedMurdererChar ~= murdererChar then
						trackedMurdererChar = murdererChar

						-- 1. Reset if Murderer Dies
						local mDeathConn
						mDeathConn = murdererHum.Died:Connect(function()
							local char = LocalPlayer.Character
							local hum = char and char:FindFirstChild("Humanoid")

							if CoinFarmEnabled and hum and hum.Health > 0 then
								hum.Health = 0 
							end
							if mDeathConn then mDeathConn:Disconnect() end
						end)

						-- 2. Reset if Murderer Leaves/Despawns
						local mLeaveConn
						mLeaveConn = murdererChar.AncestryChanged:Connect(function()
							if not murdererChar:IsDescendantOf(workspace) then
								local char = LocalPlayer.Character
								local hum = char and char:FindFirstChild("Humanoid")

								if CoinFarmEnabled and hum and hum.Health > 0 then
									hum.Health = 0 
								end
								if mLeaveConn then mLeaveConn:Disconnect() end
							end
						end)
					end
				else
					-- Clean up tracking
					if trackedMurdererChar ~= nil then
						trackedMurdererChar = nil
						local char = LocalPlayer.Character
						local hum = char and char:FindFirstChild("Humanoid")

						if CoinFarmEnabled and hum and hum.Health > 0 then
							hum.Health = 0
						end
					end
				end
			else
				trackedMurdererChar = nil
			end

			-- FILTERING & SORTING COINS
			local safeCoins = {}
			for _, coin in ipairs(coinContainer:GetChildren()) do
				if not coin or not coin:IsDescendantOf(workspace) then continue end
				if not (coin.Name == "Coin_Server" and coin:IsA("BasePart")) then continue end

				-- Murderer Distance Check (ONLY apply if we are NOT the murderer!)
				if not isPlayerMurderer and murdererHRP and (coin.Position - murdererHRP.Position).Magnitude <= 15 then continue end

				table.insert(safeCoins, coin)
			end

			if #safeCoins == 0 then return end

			-- Sort by distance: Closest first
			table.sort(safeCoins, function(a, b)
				return (a.Position - hrp.Position).Magnitude < (b.Position - hrp.Position).Magnitude
			end)

			-- COLLECTION LOOP WITH UNDERGROUND EVASION
			for _, coin in ipairs(safeCoins) do
				if not CoinFarmEnabled or not Active then break end
				if not coin or not coin:IsDescendantOf(workspace) then continue end

				if not hum or hum.Health <= 0 or not hrp:IsDescendantOf(workspace) then break end

				-- Calculate travel
				local distance = (hrp.Position - coin.Position).Magnitude
				local duration = distance / flightSpeed

				local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
				local tween = TweenService:Create(hrp, tweenInfo, {CFrame = coin.CFrame})

				-- EVASION & DEATH LISTENER
				local isSafe = true
				local conn
				conn = RunService.Heartbeat:Connect(function()
					-- Skip evasion entirely if the player is the murderer
					if isPlayerMurderer then return end 

					if not hrp or not hrp:IsDescendantOf(workspace) or (hum and hum.Health <= 0) then
						isSafe = false
						tween:Cancel()
						if conn then conn:Disconnect() end
						return
					end

					-- Fetch current murderer data inside the loop
					local _, murdChar = GetMurdererV1()
					local curMurdHRP = murdChar and murdChar:FindFirstChild("HumanoidRootPart")

					if curMurdHRP and (hrp.Position - curMurdHRP.Position).Magnitude <= 15 then
						isSafe = false
						tween:Cancel() 

						-- Teleport underground
						hrp.CFrame = hrp.CFrame - Vector3.new(0, hideDepth, 0)

						if conn then conn:Disconnect() end
					end

					-- UNDERGROUND EVASION: Teleports underground when danger gets too close
					if curMurdHRP and (hrp.Position - curMurdHRP.Position).Magnitude <= 20 then
						isSafe = false
						tween:Cancel() 

						local currentHideDepth = hideDepth

						-- Line of Sight (LOS) Raycast Check
						local rayOrigin = curMurdHRP.Position
						local rayDirection = hrp.Position - rayOrigin
						local rayParams = RaycastParams.new()
						rayParams.FilterDescendantsInstances = {murdChar, char} 
						rayParams.FilterType = Enum.RaycastFilterType.Exclude

						local hit = workspace:Raycast(rayOrigin, rayDirection, rayParams)
						if not hit then
							currentHideDepth = hideDepth + 40 
						end

						hrp.CFrame = hrp.CFrame - Vector3.new(0, currentHideDepth, 0)
						if conn then conn:Disconnect() end
					end
				end)

				tween:Play()
				tween.Completed:Wait() 

				if conn then conn:Disconnect() end

				-- If isSafe is false (murderer detected), execute underground hiding loop
				if not isSafe then 
					if isPlayerMurderer then continue end 

					if hrp and hrp:IsDescendantOf(workspace) then
						hrp.Anchored = true
						hrp.AssemblyLinearVelocity = Vector3.zero
					end

					-- Wait underground until horizontal distance from murderer is safe (> 20 studs)
					while true do
						local _, murdChar = GetMurdererV1()
						local curMurdHRP = murdChar and murdChar:FindFirstChild("HumanoidRootPart")

						if not curMurdHRP then break end 

						local horizontalDist = math.sqrt((hrp.Position.X - curMurdHRP.Position.X)^2 + (hrp.Position.Z - curMurdHRP.Position.Z)^2)
						if horizontalDist > 20 then
							break 
						end
						task.wait(0.2)
						if not hum or hum.Health <= 0 then break end
					end

					-- Unanchor and RESURFACE
					if hrp and hrp:IsDescendantOf(workspace) then
						hrp.CFrame = hrp.CFrame + Vector3.new(0, hideDepth, 0) 
						hrp.AssemblyLinearVelocity = Vector3.zero
						hrp.Anchored = false
					end

					continue 
				end

				task.wait(0.1) 
			end
		end)

		if not success then
		end
	end
end)

