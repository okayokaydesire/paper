CreateRow(funPage, "View RC Car", "Lets you view your RC Car.", false, function(state)
	ViewRCCarEnabled = state
	local camera = workspace.CurrentCamera
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local head = char and char:FindFirstChild("Head") -- Added to check player validity

	if state then
		if viewRCCarConnection then viewRCCarConnection:Disconnect() end
		viewRCCarConnection = RunService.RenderStepped:Connect(function()
			if not ViewRCCarEnabled then return end

			-- Only works if WalkSpeed and JumpPower are 0
			if hum and hrp and hum.WalkSpeed == 0 and hum.JumpPower == 0 then
				local rcCarsFolder = workspace:FindFirstChild("RCCars")

				if rcCarsFolder then
					local nearestCar = nil
					local shortestDist = math.huge

					-- Find the nearest RCCar
					for _, item in ipairs(rcCarsFolder:GetChildren()) do
						if item.Name == "RCCar" and item:IsA("Model") then
							local body = item:FindFirstChild("Body")
							if body and body:IsA("MeshPart") then
								local dist = (body.Position - hrp.Position).Magnitude
								if dist < shortestDist then
									shortestDist = dist
									nearestCar = item
								end
							end
						end
					end

					-- View the Body of the nearest car
					if nearestCar then
						local body = nearestCar:FindFirstChild("Body")
						if body then
							camera.CameraSubject = body
						end
					else
						camera.CameraSubject = hum
					end
				end
			else
				-- Revert to player if requirements aren't met
				camera.CameraSubject = hum
			end
		end)
	else
		-- Disable and clean up
		if viewRCCarConnection then
			viewRCCarConnection:Disconnect()
			viewRCCarConnection = nil
		end

		-- Aggressive Camera Reset
		if hum and head then
			camera.CameraSubject = hum
			camera.CameraType = Enum.CameraType.Custom

			local resetCount = 0
			local forceResetConn

			-- Force the camera to stay on the player for 10 frames to overpower native scripts
			forceResetConn = RunService.RenderStepped:Connect(function()
				resetCount = resetCount + 1
				camera.CameraSubject = hum
				camera.CameraType = Enum.CameraType.Custom

				if resetCount > 10 then
					forceResetConn:Disconnect()
					forceResetConn = nil
				end
			end)
		end
	end
end)

